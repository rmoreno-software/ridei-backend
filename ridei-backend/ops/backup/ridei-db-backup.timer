# /etc/systemd/system/ridei-db-backup.timer — copia diaria a las 03:30 UTC.
# Persistent=true: si el servidor estaba apagado a esa hora, se ejecuta al arrancar.
[Unit]
Description=Daily Ridei database backup

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
