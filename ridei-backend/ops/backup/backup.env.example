# /etc/ridei-backup/backup.env — configuración no secreta (formato systemd EnvironmentFile).

# Bases de datos a copiar: "contenedor:superusuario:base_de_datos", separadas por espacios.
BACKUP_TARGETS="ridei-postgres:ridei:ridei_identity ridei-postgres:ridei:ridei_garage ridei-postgis:postgres:ridei_circuits"

# Clave(s) PÚBLICA(S) age, una por línea. La privada NO vive en el servidor.
BACKUP_AGE_RECIPIENTS_FILE=/etc/ridei-backup/age-recipients.txt

BACKUP_DIR=/var/backups/ridei
BACKUP_LOCAL_RETENTION_DAYS=7

# Destino: remote rclone "r2" definido por las variables RCLONE_CONFIG_R2_* (sin rclone.conf).
BACKUP_R2_REMOTE=r2
BACKUP_R2_BUCKET=ridei-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private

# Opcional: URL a la que hacer GET tras una copia correcta (p. ej. healthchecks.io), para
# recibir un aviso si un día NO llega el ping.
BACKUP_HEARTBEAT_URL=
